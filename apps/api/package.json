{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "@repo/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
