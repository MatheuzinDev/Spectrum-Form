{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.js", ".prettierrc"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "REDIS_URL", "CACHE_ENABLED"]
    },
    "lint": {},
    "format:check": {},
    "db:migrate": { "cache": false },
    "db:seed": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
